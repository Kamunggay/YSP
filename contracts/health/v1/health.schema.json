{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ysp.invalid/health/v1/health.schema.json",
  "title": "P01 read-only infrastructure health HTTP response",
  "description": "GET /api/v1/health; no business operation or authorization. Response headers include Cache-Control: no-store, private. Separate from transport ActionResult.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "body"],
      "properties": {
        "status": { "const": 200 },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "database"],
          "properties": { "status": { "const": "ok" }, "database": { "const": "ok" } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "body"],
      "properties": {
        "status": { "const": 503 },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "database"],
          "properties": { "status": { "const": "unavailable" }, "database": { "const": "unavailable" } }
        }
      }
    }
  ]
}
