{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ysp:stock-holds:v1",
  "title": "Stock hold coverage, clearance and eligibility - 1.0.0-review.1",
  "description": "P00 stage-0-leader/03, 2026-10-24, parent https://github.com/Kamunggay/YSP/issues/2. Leader-authored review candidate. Reuses transport and identity-record-evidence v1. Mandatory cross-value and commit checks are in coverage-model.md/internal-operations.md. Wire and design examples are not a query/posting provider, migrations, P05/P06 acceptance or Glenn/Efren validation. Requirements INV-03-INV-05, INV-07-INV-08, INV-10, INV-14; TR-06-TR-10, TR-12; accepted Q1/Q7/Q8. Candidate requirements remain candidates.",
  "$defs": {
    "Purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use",
        "event_id",
        "requesting_unit_id",
        "intended_use_at"
      ],
      "properties": {
        "use": {
          "enum": [
            "internal",
            "sale",
            "booth_checkout",
            "booth_sale"
          ]
        },
        "event_id": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "requesting_unit_id": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "intended_use_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        }
      },
      "description": "Server checks allowed use AND event AND requesting unit AND effective interval AND interpreted restriction. Booth sale requires sale and booth permission. Missing required context blocks; unrestricted context is never inferred."
    },
    "QueryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "variant_id",
        "unit_id",
        "purpose",
        "requested_quantity",
        "lot_ids",
        "location_ids"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "variant_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "unit_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "purpose": {
          "$ref": "#/$defs/Purpose"
        },
        "requested_quantity": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "lot_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/Id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "location_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/Id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "description": "Normalized authorized internal query. Empty lot/location filters mean all authorized positions for this variant; not all chapters. Unit and scale must match variant. No client balance, override, actor or allocation selection."
    },
    "Dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "variant_id",
        "unit_id",
        "quantity_scale",
        "lot_id",
        "position_id",
        "location_id",
        "custody_assignment_id",
        "custodian_user_id",
        "custody_kind",
        "condition_code",
        "lot_kind",
        "restriction_version_id",
        "source"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "variant_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "unit_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "quantity_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "lot_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "position_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "location_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "custody_assignment_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "custodian_user_id": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "custody_kind": {
          "enum": [
            "stockroom",
            "booth"
          ]
        },
        "condition_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "lot_kind": {
          "enum": [
            "accepted",
            "nonusable"
          ]
        },
        "restriction_version_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "source": {
          "allOf": [
            {
              "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/LineReference"
            },
            {
              "type": "object",
              "properties": {
                "record": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "RM"
                    }
                  }
                },
                "line_kind": {
                  "const": "RM"
                }
              }
            }
          ]
        }
      }
    },
    "GuardPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "eligibility_version",
        "position_versions"
      ],
      "properties": {
        "variant_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "eligibility_version": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "position_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position_id",
              "row_version"
            ],
            "properties": {
              "position_id": {
                "$ref": "urn:ysp:transport:v1#/$defs/Id"
              },
              "row_version": {
                "$ref": "urn:ysp:transport:v1#/$defs/Version"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "description": "Server-owned state token, not authority or a reservation. Covers every cell/hold/reservation change and dimensional/eligibility change; commit always rechecks current roots and exact position set."
    },
    "Freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_at",
        "state",
        "guards",
        "policy_version_id",
        "restriction_version_ids"
      ],
      "properties": {
        "read_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        },
        "state": {
          "enum": [
            "current",
            "stale"
          ]
        },
        "guards": {
          "$ref": "#/$defs/GuardPin"
        },
        "policy_version_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "restriction_version_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/Id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "description": "One authorized committed read snapshot. Current describes that read instant only. No cache lifetime or screen read confers commitment authority. Missing/unavailable reads must not be represented as zero stock."
    },
    "StockViews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usable_stockroom_on_hand",
        "available_to_allocate",
        "rf_reserved",
        "so_reserved",
        "booth_custody",
        "quarantined_rejected",
        "inbound_open_po"
      ],
      "properties": {
        "usable_stockroom_on_hand": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "available_to_allocate": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "rf_reserved": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "so_reserved": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "booth_custody": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "quarantined_rejected": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "inbound_open_po": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        }
      },
      "description": "Seven related nonadditive views; exact scope and basis are defined in walkthrough.md. Held union is an explanation, never an eighth additive stock bucket."
    },
    "UnionExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_before_holds_and_reservations",
        "active_held_union",
        "reserved_in_eligible",
        "held_reserved_intersection",
        "blocked_union",
        "available_to_allocate"
      ],
      "properties": {
        "eligible_before_holds_and_reservations": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "active_held_union": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "reserved_in_eligible": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "held_reserved_intersection": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "blocked_union": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "available_to_allocate": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        }
      },
      "description": "For base E (accepted usable stockroom cells passing non-hold restrictions), H and R are intersected with E: blocked = |H union R| = held + reserved - intersection; available = |E| - blocked. Reserved headline views may include currently ineligible commitments and are not blindly subtracted."
    },
    "CoverageCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "dimension",
        "start",
        "end",
        "quantity",
        "active_hold_ids",
        "active_reservation_id",
        "non_hold_eligibility",
        "blocking_codes"
      ],
      "properties": {
        "cell_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "start": {
          "$ref": "urn:ysp:transport:v1#/$defs/Quantity"
        },
        "end": {
          "$ref": "urn:ysp:transport:v1#/$defs/Quantity"
        },
        "quantity": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "active_hold_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/Id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "active_reservation_id": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "non_hold_eligibility": {
          "enum": [
            "eligible",
            "restricted",
            "unsupported_condition",
            "wrong_purpose",
            "outside_effective_interval",
            "nonusable",
            "booth_custody"
          ]
        },
        "blocking_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "description": "Server projection of a live disjoint half-open interval in an immutable lot coordinate. quantity=end-start at approved unit quantum. Source origin never changes. Hold and reservation links must exactly cover whole live cells; split first, with inheritance. Shape validation does not prove interval or FK integrity."
    },
    "HoldSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold_id",
        "row_version",
        "reason_code",
        "source",
        "coverage_cell_ids",
        "quantity"
      ],
      "properties": {
        "hold_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "row_version": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source": {
          "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/MaterialReference"
        },
        "coverage_cell_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/Id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "quantity": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        }
      },
      "description": "Independent active reason and its source provenance. Per-reason quantities are explanatory and must never be summed to calculate held union."
    },
    "DemandLineReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "record",
        "line_id",
        "variant_id"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "record": {
          "allOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "RF",
                    "SO"
                  ]
                }
              }
            }
          ]
        },
        "line_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "variant_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        }
      },
      "description": "Reporting reference to an existing typed demand line; no RF/SO command contract is introduced. Parent/kind/chapter/variant must match the actual typed demand line."
    },
    "ReservationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reservation_id",
        "demand_line",
        "kind",
        "protection",
        "coverage_cell_ids",
        "quantity",
        "expires_at"
      ],
      "properties": {
        "reservation_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "demand_line": {
          "$ref": "#/$defs/DemandLineReference"
        },
        "kind": {
          "enum": [
            "RF",
            "SO"
          ]
        },
        "protection": {
          "enum": [
            "rf",
            "unpaid_expirable",
            "paid",
            "funded"
          ]
        },
        "coverage_cell_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/Id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "quantity": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Active physical coverage only. Protected outstanding demand that loses physical coverage during authorized condition treatment remains separately recorded; holds/clearance cannot cancel it."
    },
    "InboundLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "po_line",
        "open_quantity",
        "expected_location_id"
      ],
      "properties": {
        "po_line": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chapter_id",
            "record",
            "line_id",
            "variant_id"
          ],
          "properties": {
            "chapter_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "record": {
              "allOf": [
                {
                  "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "PO"
                    }
                  }
                }
              ]
            },
            "line_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "variant_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            }
          }
        },
        "open_quantity": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "expected_location_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        }
      },
      "description": "Only approved PO outstanding supply, not stock cells. PO kind/parent/variant and cumulative accepted/canceled limits are server checks; held/rejected receipts do not become usable here."
    },
    "EligibilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "chapter_id",
        "query",
        "freshness",
        "views",
        "union",
        "cells",
        "holds",
        "reservations",
        "inbound",
        "rop",
        "shortage"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "query": {
          "$ref": "#/$defs/QueryInput"
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "views": {
          "$ref": "#/$defs/StockViews"
        },
        "union": {
          "$ref": "#/$defs/UnionExplanation"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoverageCell"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "holds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HoldSummary"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reservations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReservationSummary"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "inbound": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InboundLine"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "rop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_threshold",
            "usable_on_hand",
            "low_stock"
          ],
          "properties": {
            "approved_threshold": {
              "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
            },
            "usable_on_hand": {
              "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
            },
            "low_stock": {
              "type": "boolean"
            }
          }
        },
        "shortage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested_quantity",
            "available_quantity",
            "uncovered_quantity"
          ],
          "properties": {
            "requested_quantity": {
              "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
            },
            "available_quantity": {
              "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
            },
            "uncovered_quantity": {
              "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
            }
          }
        }
      },
      "description": "A read is not an operation success envelope and never creates a reservation. All arrays and aggregates use the same authorized snapshot; no pagination silently drops coverage. If details are unauthorized, deny the query rather than return hidden IDs or falsified totals. This defines no endpoint or Glenn query implementation."
    },
    "EvidencePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "target",
        "evidence",
        "purpose_code"
      ],
      "properties": {
        "binding_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "target": {
          "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/MaterialReference"
        },
        "evidence": {
          "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/ReadyEvidenceReference"
        },
        "purpose_code": {
          "enum": [
            "hold_finding",
            "hold_clearance"
          ]
        }
      },
      "description": "Documents resolves the actual authorized ready binding/material pin, immutable bytes/hash/version, purpose, signer and target. A supplied pin is not proof of readiness or authority."
    },
    "CreateHoldInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "finding",
        "reason_code",
        "coverage",
        "expected_guards",
        "evidence"
      ],
      "properties": {
        "context": {
          "allOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/CommandContext"
            },
            {
              "type": "object",
              "required": [
                "expected_material_version"
              ],
              "properties": {
                "action_code": {
                  "const": "inventory.record_stock_hold"
                },
                "record": {
                  "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
                },
                "expected_row_version": {
                  "$ref": "urn:ysp:transport:v1#/$defs/Version"
                },
                "expected_material_version": {
                  "$ref": "urn:ysp:transport:v1#/$defs/Version"
                }
              }
            }
          ]
        },
        "finding": {
          "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/MaterialReference"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lot_id",
              "position_id",
              "start",
              "end"
            ],
            "properties": {
              "lot_id": {
                "$ref": "urn:ysp:transport:v1#/$defs/Id"
              },
              "position_id": {
                "$ref": "urn:ysp:transport:v1#/$defs/Id"
              },
              "start": {
                "$ref": "urn:ysp:transport:v1#/$defs/Quantity"
              },
              "end": {
                "$ref": "urn:ysp:transport:v1#/$defs/Quantity"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expected_guards": {
          "$ref": "#/$defs/GuardPin"
        },
        "evidence": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/EvidencePin"
              },
              {
                "type": "object",
                "properties": {
                  "purpose_code": {
                    "const": "hold_finding"
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "description": "Internal normalized finding command; coverage must be resolved from identified server-owned stock/evidence and checked against current cells, not treated as authoritative client allocation. It never changes physical quantity/condition. Finding record kind is owned by its workflow; no generic public posting route is created."
    },
    "ClearHoldInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "hold_id",
        "expected_hold_row_version",
        "resolution",
        "reason",
        "expected_guards",
        "evidence"
      ],
      "properties": {
        "context": {
          "allOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/CommandContext"
            },
            {
              "type": "object",
              "required": [
                "expected_material_version"
              ],
              "properties": {
                "action_code": {
                  "const": "inventory.clear_stock_hold"
                },
                "record": {
                  "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
                },
                "expected_row_version": {
                  "$ref": "urn:ysp:transport:v1#/$defs/Version"
                },
                "expected_material_version": {
                  "$ref": "urn:ysp:transport:v1#/$defs/Version"
                }
              }
            }
          ]
        },
        "hold_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "expected_hold_row_version": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "resolution": {
          "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/MaterialReference"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "expected_guards": {
          "$ref": "#/$defs/GuardPin"
        },
        "evidence": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/EvidencePin"
              },
              {
                "type": "object",
                "properties": {
                  "purpose_code": {
                    "const": "hold_clearance"
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "description": "Full clearance of exactly one reason. Partial coverage clearance is not enabled by this revision. Authorized source/evidence/material checks and guards are mandatory. Clearing a hold is never a stock movement or donor-restriction override."
    },
    "HoldChangeData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold_id",
        "hold_row_version",
        "state",
        "source",
        "resolution",
        "reason",
        "actor",
        "evidence",
        "affected_cell_ids",
        "guards",
        "physical_quantity_changed",
        "condition_changed",
        "movement_ids",
        "audit_event_id",
        "follow_up_task_ids"
      ],
      "properties": {
        "hold_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "hold_row_version": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "state": {
          "enum": [
            "active",
            "cleared"
          ]
        },
        "source": {
          "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/MaterialReference"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/MaterialReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "actor": {
          "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/Attribution"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidencePin"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "affected_cell_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/Id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "guards": {
          "$ref": "#/$defs/GuardPin"
        },
        "physical_quantity_changed": {
          "const": false
        },
        "condition_changed": {
          "const": false
        },
        "movement_ids": {
          "type": "array",
          "maxItems": 0
        },
        "audit_event_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "follow_up_task_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/Id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "cleared"
              }
            }
          },
          "then": {
            "properties": {
              "resolution": {
                "$ref": "urn:ysp:identity-record-evidence:v1#/$defs/MaterialReference"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/EvidencePin"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "purpose_code": {
                          "const": "hold_clearance"
                        }
                      }
                    }
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "else": {
            "properties": {
              "resolution": {
                "type": "null"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/EvidencePin"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "purpose_code": {
                          "const": "hold_finding"
                        }
                      }
                    }
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "HoldChangeResult": {
      "allOf": [
        {
          "$ref": "urn:ysp:transport:v1#/$defs/ActionResult"
        },
        {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "action_result": {
              "const": "success"
            },
            "operation": {
              "type": "object",
              "properties": {
                "identity": {
                  "type": "object",
                  "properties": {
                    "action_code": {
                      "enum": [
                        "inventory.record_stock_hold",
                        "inventory.clear_stock_hold"
                      ]
                    }
                  }
                }
              }
            },
            "data": {
              "$ref": "#/$defs/HoldChangeData"
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "type": "object",
                "properties": {
                  "identity": {
                    "type": "object",
                    "properties": {
                      "action_code": {
                        "const": "inventory.clear_stock_hold"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "cleared"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "active"
                  }
                }
              }
            }
          }
        }
      ],
      "type": "object"
    },
    "UnchangedResult": {
      "allOf": [
        {
          "$ref": "urn:ysp:transport:v1#/$defs/ActionResult"
        },
        {
          "type": "object",
          "properties": {
            "action_result": {
              "enum": [
                "blocked",
                "stale",
                "forbidden",
                "uncertain"
              ]
            },
            "data": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
