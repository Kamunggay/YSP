{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ysp:identity-record-evidence:v1",
  "title": "Identity, record and evidence boundary - 1.0.0-review.1",
  "description": "P00 stage-0-leader/08, 2026-10-24. Parent https://github.com/Kamunggay/YSP/issues/2. Leader-authored review candidate; Glenn/Efren acceptance pending. Shared refs require urn:ysp:transport:v1 registration from ../../transport/v1/transport.schema.json. This schema validates wire shape; boundary.json defines mandatory server relationship/authority/hash checks. No authentication, approval, evidence validation or stock provider is implemented. Requirements GOV-01-GOV-09, DOC-01-DOC-11, TR-03/TR-06-TR-10/TR-15-TR-18, SEC-01-SEC-04; Q4-Q5. PRD/TRD candidates are not promoted.",
  "$defs": {
    "Hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 hex computed by the server. File bytes and canonical business snapshots have separate digests; a digest establishes integrity, never identity or authority."
    },
    "Duty": {
      "enum": [
        "COMMITTEE_REQUESTER",
        "RF_APPROVER",
        "SALES_OFFICER",
        "SALES_REVIEWER",
        "FINANCE",
        "INVENTORY",
        "PURCHASING",
        "BUDGET_APPROVER",
        "RECEIVING",
        "DISPATCH",
        "BOOTH_CUSTODIAN",
        "BOOTH_CASHIER",
        "INDEPENDENT_REVIEWER",
        "CHAPTER_HEAD"
      ]
    },
    "Attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "user_id",
        "membership_id",
        "duty_grant_id",
        "duty_code",
        "actor_name",
        "chapter_name",
        "captured_at"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "user_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "membership_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "duty_grant_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "duty_code": {
          "$ref": "#/$defs/Duty"
        },
        "actor_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "chapter_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "captured_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        }
      },
      "description": "Immutable officer attribution. Membership/user/grant tuple is server-resolved, not request authority. Historical attribution survives disable/reassignment; current execution must reauthorize. Provider/system actors cannot substitute for human sign-off."
    },
    "DutyGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "duty_code",
        "scope_kind",
        "requesting_unit_id",
        "starts_at",
        "ends_at",
        "revoked_at"
      ],
      "properties": {
        "id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "duty_code": {
          "$ref": "#/$defs/Duty"
        },
        "scope_kind": {
          "enum": [
            "chapter",
            "unit"
          ]
        },
        "requesting_unit_id": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "starts_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        },
        "ends_at": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked_at": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Current effective grant read model. Expiry/revocation and contextual independence are checked by Access, not inferred by clients.",
      "allOf": [
        {
          "if": {
            "properties": {
              "scope_kind": {
                "const": "unit"
              }
            }
          },
          "then": {
            "properties": {
              "requesting_unit_id": {
                "$ref": "urn:ysp:transport:v1#/$defs/Id"
              }
            }
          },
          "else": {
            "properties": {
              "requesting_unit_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "CurrentContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "user_id",
        "chapter_id",
        "chapter_name",
        "membership_id",
        "authority_version",
        "checked_at",
        "mfa_satisfied",
        "duty_grants",
        "available_actions",
        "provider_roles"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "user_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "chapter_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "membership_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "authority_version": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "checked_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        },
        "mfa_satisfied": {
          "type": "boolean"
        },
        "duty_grants": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/DutyGrant"
          }
        },
        "available_actions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "urn:ysp:transport:v1#/$defs/ActionCode"
          }
        },
        "provider_roles": {
          "type": "array",
          "minItems": 0,
          "items": {
            "enum": [
              "provisioner",
              "billing_admin",
              "recovery_operator"
            ]
          }
        }
      },
      "description": "Authorized server response for one active membership, never a signed capability or client command. Selected chapter/duty only requests context; provider roles have no operational implication. A provider without chapter membership receives a forbidden result, not this context. Every owning operation/query/job/download rechecks current user, membership, effective grants, MFA, independent identities, policy, stage and entitlement. No session, MFA secret or recovery material is exposed."
    },
    "MaterialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "record",
        "material_version",
        "material_hash"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "record": {
          "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
        },
        "material_version": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "material_hash": {
          "$ref": "#/$defs/Hash"
        }
      },
      "description": "Immutable version pin owned by P03. Compare the entire chapter/record/material tuple and hash, never only a global-looking ID."
    },
    "LineReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "record",
        "line_id",
        "line_kind",
        "variant_id"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "record": {
          "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
        },
        "line_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "line_kind": {
          "enum": [
            "IPC",
            "RM",
            "IS_AR",
            "CUSTOMER_DR"
          ]
        },
        "variant_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        }
      },
      "description": "Stable server-assigned line identity, not line number or array offset. Enforce same chapter, typed parent, line kind and variant. Removed lines retire with history; IDs are never recycled."
    },
    "PolicyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "policy_id",
        "policy_version_id",
        "version_no",
        "settings_hash",
        "approval",
        "effective_from",
        "effective_until"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "policy_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "policy_version_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "version_no": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "settings_hash": {
          "$ref": "#/$defs/Hash"
        },
        "approval": {
          "$ref": "#/$defs/MaterialReference"
        },
        "effective_from": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        },
        "effective_until": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Server-resolved approved CONFIG version, not a trusted approved flag. Access owns policy validity; P03 owns its CONFIG material snapshot/approval history. Consumer checks current effective interval, approval duties and scoped version at execution. New policy never silently recalculates completed records."
    },
    "DraftRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "reference",
        "row_version",
        "material_version",
        "approval_state",
        "draft_payload"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "reference": {
          "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
        },
        "row_version": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "material_version": {
          "type": "null"
        },
        "approval_state": {
          "const": "draft"
        },
        "draft_payload": {
          "type": "object"
        }
      },
      "description": "P03 incomplete registry/draft read model before first submission; no material snapshot/approval authority. Save increments row_version. Returned edits also use draft_payloads while retaining the prior submitted version separately. Only the owning source contract defines complete submission fields; no generic registry mutation can post stock/money."
    },
    "ReviewDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "policy",
        "decision",
        "actor",
        "decided_at",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "target": {
          "$ref": "#/$defs/MaterialReference"
        },
        "policy": {
          "$ref": "#/$defs/PolicyReference"
        },
        "decision": {
          "enum": [
            "approve",
            "return",
            "hold",
            "reject",
            "cancel"
          ]
        },
        "actor": {
          "$ref": "#/$defs/Attribution"
        },
        "decided_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "description": "Append-only review against a requirement for this exact record/material/policy. Required steps and actual distinct identities are checked by the owning decision; possessing multiple duties does not create multiple people. A receiving preparer may post an inspected RM when authorized: no global preparer/poster inequality."
    },
    "OpeningLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "location_id",
        "custody_assignment_id",
        "condition_code",
        "counted_quantity",
        "unit_valuation",
        "valuation_basis",
        "restriction_version_id"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/LineReference"
        },
        "location_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "custody_assignment_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "condition_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "counted_quantity": {
          "$ref": "urn:ysp:transport:v1#/$defs/UnitQuantity"
        },
        "unit_valuation": {
          "$ref": "urn:ysp:transport:v1#/$defs/Quantity"
        },
        "valuation_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "restriction_version_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        }
      },
      "description": "IPC source content only. Scale, location/custody, condition, restrictions and valuation are approved server metadata, not client allocation authority. Full IPC/RM/lot enforcement belongs to ticket 02/P06."
    },
    "OpeningMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "record",
        "counted_at",
        "purpose",
        "policy_version_id",
        "counters",
        "lines"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "record": {
          "allOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "IPC"
                }
              }
            }
          ]
        },
        "counted_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "policy_version_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "counters": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "user_id",
              "is_regular_custodian"
            ],
            "properties": {
              "user_id": {
                "$ref": "urn:ysp:transport:v1#/$defs/Id"
              },
              "is_regular_custodian": {
                "type": "boolean"
              }
            }
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/OpeningLine"
          }
        }
      },
      "description": "Canonical IPC material snapshot for the opening walkthrough. Validate complete source content before publication; count participants must include at least two people and one independent of the regular custodian. Required counter and Head/Finance signatures are separate evidence and checked by P06."
    },
    "VersionedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "target",
        "previous_version",
        "material",
        "prepared_by",
        "policy",
        "decisions"
      ],
      "properties": {
        "state": {
          "allOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordState"
            },
            {
              "type": "object",
              "properties": {
                "states": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "approval",
                    "progress",
                    "exception"
                  ],
                  "properties": {
                    "approval": {
                      "enum": [
                        "submitted",
                        "approved",
                        "returned",
                        "requires_review"
                      ]
                    },
                    "progress": {
                      "enum": [
                        "not_started",
                        "partial",
                        "complete"
                      ]
                    },
                    "exception": {
                      "enum": [
                        "none",
                        "open",
                        "resolved"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/MaterialReference"
        },
        "previous_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "material": {
          "$ref": "#/$defs/OpeningMaterial"
        },
        "prepared_by": {
          "$ref": "#/$defs/Attribution"
        },
        "policy": {
          "$ref": "#/$defs/PolicyReference"
        },
        "decisions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/ReviewDecision"
          }
        }
      },
      "description": "P03 plus Purchasing/Receiving-owned IPC read model for review, not accepted stock. Material content hashes to target; all nested chapter/record/line/policy and review targets must agree. approval/progress/exception are independent state axes. Draft -> submitted -> approved or returned; resubmission/revision publishes a new immutable material snapshot and invalidates affected old approvals without copying them. Partial execution advances concurrency/progress while unchanged material keeps its version."
    },
    "ReadyEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "evidence_object_id",
        "content_hash",
        "object_version"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "evidence_object_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "object_version": {
          "type": "string",
          "minLength": 4,
          "maxLength": 340,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
        }
      },
      "description": "P04 immutable byte identity; object_version is base64 of the opaque storage-version bytes (1-255 bytes). Do not decode to a number, URL or mutable latest-key pointer. Server computes content_hash from the stored nonempty bytes. Possession never authorizes binding/download and does not imply current availability."
    },
    "EvidenceState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chapter_id",
            "evidence_object_id",
            "intended_record",
            "capture_mode",
            "outcome",
            "lifecycle",
            "staging_expires_at"
          ],
          "properties": {
            "chapter_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "evidence_object_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "intended_record": {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
            },
            "capture_mode": {
              "enum": [
                "upload",
                "canvas",
                "paper_scan"
              ]
            },
            "outcome": {
              "const": "staged"
            },
            "lifecycle": {
              "const": "staged"
            },
            "staging_expires_at": {
              "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
            }
          },
          "description": "Uploaded/staged only; no ready binding or stock effect."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chapter_id",
            "evidence_object_id",
            "intended_record",
            "capture_mode",
            "outcome",
            "lifecycle"
          ],
          "properties": {
            "chapter_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "evidence_object_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "intended_record": {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
            },
            "capture_mode": {
              "enum": [
                "upload",
                "canvas",
                "paper_scan"
              ]
            },
            "outcome": {
              "const": "validating"
            },
            "lifecycle": {
              "const": "validating"
            }
          },
          "description": "Validator checks stored content/type/size, configured limits, safe handling and hash; no posting authority."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chapter_id",
            "evidence_object_id",
            "intended_record",
            "capture_mode",
            "outcome",
            "lifecycle",
            "reference",
            "validated_at",
            "validator_version",
            "mime_type",
            "byte_size"
          ],
          "properties": {
            "chapter_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "evidence_object_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "intended_record": {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
            },
            "capture_mode": {
              "enum": [
                "upload",
                "canvas",
                "paper_scan"
              ]
            },
            "outcome": {
              "const": "ready"
            },
            "lifecycle": {
              "const": "ready"
            },
            "reference": {
              "$ref": "#/$defs/ReadyEvidenceReference"
            },
            "validated_at": {
              "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
            },
            "validator_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "mime_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "byte_size": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            }
          },
          "description": "Nonempty actual bytes validated; canvas must be PNG, paper scans accepted validated image/PDF. Optional stroke JSON is supplementary. Current availability still rechecked when consumed.",
          "allOf": [
            {
              "if": {
                "properties": {
                  "capture_mode": {
                    "const": "canvas"
                  }
                }
              },
              "then": {
                "properties": {
                  "mime_type": {
                    "const": "image/png"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chapter_id",
            "evidence_object_id",
            "intended_record",
            "capture_mode",
            "outcome",
            "lifecycle",
            "reason"
          ],
          "properties": {
            "chapter_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "evidence_object_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "intended_record": {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
            },
            "capture_mode": {
              "enum": [
                "upload",
                "canvas",
                "paper_scan"
              ]
            },
            "outcome": {
              "const": "rejected"
            },
            "lifecycle": {
              "const": "quarantined"
            },
            "reason": {
              "$ref": "urn:ysp:transport:v1#/$defs/BlockingReason"
            }
          },
          "description": "Validation rejection maps to governing storage lifecycle quarantined, never a new persisted rejected enum. Retain rejected attempt; replacement uses a new immutable object."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chapter_id",
            "evidence_object_id",
            "intended_record",
            "capture_mode",
            "outcome",
            "lifecycle",
            "reference",
            "reason"
          ],
          "properties": {
            "chapter_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "evidence_object_id": {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            "intended_record": {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
            },
            "capture_mode": {
              "enum": [
                "upload",
                "canvas",
                "paper_scan"
              ]
            },
            "outcome": {
              "const": "unavailable"
            },
            "lifecycle": {
              "enum": [
                "missing",
                "archived"
              ]
            },
            "reference": {
              "$ref": "#/$defs/ReadyEvidenceReference"
            },
            "reason": {
              "$ref": "urn:ysp:transport:v1#/$defs/BlockingReason"
            }
          },
          "description": "Previously ready immutable reference is retained; missing bytes or archived/unretrievable evidence block commitment. Do not silently replace with a latest object."
        }
      ]
    },
    "EvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "line",
        "evidence",
        "purpose_code",
        "bound_by",
        "bound_at",
        "operation_id"
      ],
      "properties": {
        "id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "target": {
          "$ref": "#/$defs/MaterialReference"
        },
        "line": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/ReadyEvidenceReference"
        },
        "purpose_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bound_by": {
          "$ref": "#/$defs/Attribution"
        },
        "bound_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        },
        "operation_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/OperationId"
        }
      },
      "description": "Authorized append-only P04 binding to business record/optional same-parent line and pinned material. Evidence must be intended for this record or explicitly authorized to bind under source policy; draft ownership alone does not confer bind authority. Immutable bound_hash/object_version are represented by evidence.content_hash/object_version. P03 material-version pin is an internal consumer requirement, not a claim of an existing evidence_bindings column. Recheck evidence identity/readiness at commitment in the owner transaction."
    },
    "EvidenceCheckInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "target",
        "line",
        "evidence",
        "purpose_code"
      ],
      "properties": {
        "context": {
          "allOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/CommandContext"
            },
            {
              "type": "object",
              "required": [
                "expected_material_version"
              ],
              "properties": {
                "record": {
                  "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
                },
                "expected_row_version": {
                  "$ref": "urn:ysp:transport:v1#/$defs/Version"
                },
                "expected_material_version": {
                  "$ref": "urn:ysp:transport:v1#/$defs/Version"
                }
              }
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/MaterialReference"
        },
        "line": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/ReadyEvidenceReference"
        },
        "purpose_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "description": "Normalized internal consumer input, not a generic HTTP posting command. Adapter supplies chapter/action/key; expected row AND material version are mandatory for existing targets. Client may propose references; Access/P03/P04 resolve and verify them. No actor/grant/policy/ready flag is accepted as authority. Purchasing/Receiving owns IPC/RM acceptance; Documents participates without a nested commit."
    },
    "Recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "user_id",
        "capacity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "user_id": {
          "anyOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "capacity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "description": "Exact recipient facts confirmed by the capturing officer. A buyer/recipient is not implicitly an authenticated chapter member."
    },
    "BatchSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "record",
        "material_version",
        "batch_id",
        "recipient",
        "lines"
      ],
      "properties": {
        "chapter_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "record": {
          "allOf": [
            {
              "$ref": "urn:ysp:transport:v1#/$defs/RecordReference"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "IS_AR",
                    "CUSTOMER_DR"
                  ]
                }
              }
            }
          ]
        },
        "material_version": {
          "$ref": "urn:ysp:transport:v1#/$defs/Version"
        },
        "batch_id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "recipient": {
          "$ref": "#/$defs/Recipient"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "quantity"
            ],
            "properties": {
              "line": {
                "$ref": "#/$defs/LineReference"
              },
              "quantity": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,13})\\.[0-9]{6}$",
                "not": {
                  "const": "0.000000"
                }
              }
            }
          }
        }
      },
      "description": "Exact actual batch, unique stable lines and positive quantities, ordered by numeric line ID (length, then lexical), quantities normalized to six places. P04 server hash uses ysp-batch-v1 fixed-order UTF-8 JSON described in boundary.json. Exclude row_version so unchanged approved partial progress does not invalidate content; changed batch ID, recipient, line, quantity or material requires fresh matching acknowledgment."
    },
    "Acknowledgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "snapshot",
        "acknowledged_snapshot_hash",
        "evidence_binding",
        "method",
        "signed_at",
        "captured_by"
      ],
      "properties": {
        "id": {
          "$ref": "urn:ysp:transport:v1#/$defs/Id"
        },
        "snapshot": {
          "$ref": "#/$defs/BatchSnapshot"
        },
        "acknowledged_snapshot_hash": {
          "$ref": "#/$defs/Hash"
        },
        "evidence_binding": {
          "$ref": "#/$defs/EvidenceBinding"
        },
        "method": {
          "enum": [
            "canvas",
            "paper"
          ]
        },
        "signed_at": {
          "$ref": "urn:ysp:transport:v1#/$defs/UtcInstant"
        },
        "captured_by": {
          "$ref": "#/$defs/Attribution"
        }
      },
      "description": "P04 acknowledgment for required IS/AR/customer DR consumers only, not a new booth-sale signature. Canvas Clear/Redo creates a replacement capture; paper scans follow the same ready checks. Hash covers canonical recipient/batch, separate from file hash. Binding must match same record/material/chapter; evidence mode must match method. Preserve superseded evidence. Opening count signatures use IPC participant/Head/Finance evidence, not a fictional recipient handover."
    },
    "ReadyEvidenceResult": {
      "allOf": [
        {
          "$ref": "urn:ysp:transport:v1#/$defs/ActionResult"
        },
        {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "action_result": {
              "const": "success"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "binding"
              ],
              "properties": {
                "binding": {
                  "$ref": "#/$defs/EvidenceBinding"
                }
              }
            }
          }
        }
      ]
    },
    "RejectedEvidenceResult": {
      "allOf": [
        {
          "$ref": "urn:ysp:transport:v1#/$defs/ActionResult"
        },
        {
          "type": "object",
          "properties": {
            "action_result": {
              "enum": [
                "blocked",
                "stale",
                "forbidden",
                "uncertain"
              ]
            },
            "data": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
}
