{
  "code-anastasya-approval-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./code-anastasya-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
