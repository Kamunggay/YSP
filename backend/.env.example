APP_ENV=local
# Copy to .env using scripts/init-local.ps1; never commit populated credentials.
APP_KEY=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_URL=http://localhost:8080
APP_KEY_FILE=/run/secrets/app_key
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ysp_local
DB_USERNAME=ysp_app
DB_PASSWORD_FILE=/run/secrets/db_password
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=file
LOG_CHANNEL=stderr
